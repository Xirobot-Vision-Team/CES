{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/schema/issue-plan-result.v1.schema.json",
  "description": "EC216 offline local closed-vocabulary preview; no create approval, IssueCreated, remote write, raw content disclosure or duplicate-absence proof on any branch.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "exit_code",
    "reason_code",
    "plan_state",
    "draft",
    "draft_generated_locally",
    "approval",
    "delivery_state",
    "safe_next_step",
    "evaluation_sha256",
    "eligibility_result_sha256",
    "issue_create_authorized",
    "issue_created",
    "existing_issue_edited",
    "provider_or_business_repository_written",
    "finding_or_knowledge_written",
    "local_files_persisted",
    "external_ai_called",
    "network_requested",
    "report_or_issue_published",
    "external_content_disclosed",
    "raw_source_path_or_bytes_disclosed",
    "raw_finding_or_remote_issue_content_disclosed",
    "provider_repository_issue_inventory_complete",
    "duplicate_absence_proven",
    "finding_source_or_provider_authenticated",
    "reviewer_organization_role_authenticated",
    "native_issue_action_registered"
  ],
  "properties": {
    "schema": {
      "const": "ces.issue_plan.v1"
    },
    "status": {
      "enum": [
        "partial",
        "unavailable",
        "invalid_input"
      ]
    },
    "exit_code": {
      "enum": [
        2,
        4,
        5
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^ISSUE_PLAN_[A-Z0-9_]{1,100}$"
    },
    "plan_state": {
      "enum": [
        "DRAFT_READY",
        "NEEDS_REVIEW",
        "BLOCKED",
        "UNKNOWN",
        "INVALID_INPUT"
      ]
    },
    "draft": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "target",
            "plan_sha256",
            "suggested_title",
            "suggested_body",
            "references",
            "source",
            "privacy",
            "issue_match_selected_count",
            "review_receipt_sha256",
            "content_source",
            "authorization",
            "issue_created"
          ],
          "properties": {
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider",
                "repository_identity_sha256",
                "visibility",
                "repository_name_and_numeric_id_redacted"
              ],
              "properties": {
                "provider": {
                  "enum": [
                    "github",
                    "gitlab"
                  ]
                },
                "repository_identity_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "visibility": {
                  "enum": [
                    "PUBLIC",
                    "PRIVATE"
                  ]
                },
                "repository_name_and_numeric_id_redacted": {
                  "const": true
                }
              }
            },
            "plan_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "suggested_title": {
              "type": "string",
              "minLength": 20,
              "maxLength": 100,
              "pattern": "^Investigate potential [A-Za-z -]+ \\([a-z ]+\\)$"
            },
            "suggested_body": {
              "type": "string",
              "minLength": 200,
              "maxLength": 2400,
              "pattern": "^## Proposed investigation\\n"
            },
            "references": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reference_id",
                  "anchor_index",
                  "anchor_binding_sha256",
                  "locator_redacted"
                ],
                "properties": {
                  "reference_id": {
                    "type": "string",
                    "pattern": "^E(?:0[1-9]|1[0-6])$"
                  },
                  "anchor_index": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  "anchor_binding_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "locator_redacted": {
                    "const": true
                  }
                }
              }
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "pinned_revision_sha256",
                "finding_record_sha256",
                "source_binding_sha256",
                "anchor_set_sha256",
                "selected_source_coverage_declared_complete",
                "original_bytes_not_replayed"
              ],
              "properties": {
                "mode": {
                  "const": "DeliveredTarget"
                },
                "pinned_revision_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "finding_record_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_binding_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "anchor_set_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "selected_source_coverage_declared_complete": {
                  "const": true
                },
                "original_bytes_not_replayed": {
                  "const": true
                }
              }
            },
            "privacy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "classification_redacted",
                "policy_revision_sha256",
                "local_redacted_preview_only"
              ],
              "properties": {
                "classification_redacted": {
                  "const": true
                },
                "policy_revision_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "local_redacted_preview_only": {
                  "const": true
                }
              }
            },
            "issue_match_selected_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "review_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_source": {
              "const": "BUILT_IN_CLOSED_VOCABULARY"
            },
            "authorization": {
              "const": "NOT_GRANTED"
            },
            "issue_created": {
              "const": false
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "draft_generated_locally": {
      "type": "boolean"
    },
    "approval": {
      "const": "NOT_GRANTED"
    },
    "delivery_state": {
      "const": "NOT_ATTEMPTED"
    },
    "safe_next_step": {
      "enum": [
        "HUMAN_REVIEW_OF_LOCAL_DRAFT_ONLY",
        "REVIEW_REQUIRED",
        "DO_NOT_DRAFT"
      ]
    },
    "evaluation_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "eligibility_result_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "issue_create_authorized": {
      "const": false
    },
    "issue_created": {
      "const": false
    },
    "existing_issue_edited": {
      "const": false
    },
    "provider_or_business_repository_written": {
      "const": false
    },
    "finding_or_knowledge_written": {
      "const": false
    },
    "local_files_persisted": {
      "const": false
    },
    "external_ai_called": {
      "const": false
    },
    "network_requested": {
      "const": false
    },
    "report_or_issue_published": {
      "const": false
    },
    "external_content_disclosed": {
      "const": false
    },
    "raw_source_path_or_bytes_disclosed": {
      "const": false
    },
    "raw_finding_or_remote_issue_content_disclosed": {
      "const": false
    },
    "provider_repository_issue_inventory_complete": {
      "const": false
    },
    "duplicate_absence_proven": {
      "const": false
    },
    "finding_source_or_provider_authenticated": {
      "const": false
    },
    "reviewer_organization_role_authenticated": {
      "const": false
    },
    "native_issue_action_registered": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "plan_state": {
            "const": "DRAFT_READY"
          }
        },
        "required": [
          "plan_state"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "exit_code": {
            "const": 2
          },
          "draft": {
            "type": "object"
          },
          "draft_generated_locally": {
            "const": true
          },
          "safe_next_step": {
            "const": "HUMAN_REVIEW_OF_LOCAL_DRAFT_ONLY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_state": {
            "const": "NEEDS_REVIEW"
          }
        },
        "required": [
          "plan_state"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "exit_code": {
            "const": 2
          },
          "draft": {
            "type": "null"
          },
          "draft_generated_locally": {
            "const": false
          },
          "safe_next_step": {
            "const": "REVIEW_REQUIRED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_state": {
            "const": "BLOCKED"
          }
        },
        "required": [
          "plan_state"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "partial"
          },
          "exit_code": {
            "const": 2
          },
          "draft": {
            "type": "null"
          },
          "draft_generated_locally": {
            "const": false
          },
          "safe_next_step": {
            "const": "DO_NOT_DRAFT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_state": {
            "const": "UNKNOWN"
          }
        },
        "required": [
          "plan_state"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "unavailable"
          },
          "exit_code": {
            "const": 5
          },
          "draft": {
            "type": "null"
          },
          "draft_generated_locally": {
            "const": false
          },
          "safe_next_step": {
            "const": "DO_NOT_DRAFT"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "plan_state": {
            "const": "INVALID_INPUT"
          }
        },
        "required": [
          "plan_state"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "invalid_input"
          },
          "exit_code": {
            "const": 4
          },
          "draft": {
            "type": "null"
          },
          "draft_generated_locally": {
            "const": false
          },
          "safe_next_step": {
            "const": "DO_NOT_DRAFT"
          }
        }
      }
    }
  ]
}
