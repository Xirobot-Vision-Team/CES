{
  "type": "object",
  "title": "EC200 internal append-only correction policy",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.report_history_correction_policy.v1"
    },
    "purpose": {
      "const": "periodic_report_internal_correction_append_only"
    },
    "audience": {
      "const": "HUMAN_REPORT_EDITOR_INTERNAL"
    },
    "report_slot_ref": {
      "type": "string",
      "pattern": "^cesrslot1:[0-9a-f]{64}$"
    },
    "slot_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "period_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "slot_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository_ref": {
            "type": "string",
            "pattern": "^cesrepo1:[0-9a-f]{64}$"
          },
          "report_subject_ref": {
            "type": "string",
            "pattern": "^cesrs1:[0-9a-f]{64}$"
          }
        },
        "required": [
          "repository_ref",
          "report_subject_ref"
        ]
      }
    },
    "store_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permit_append_correction": {
      "const": true
    },
    "expected_previous_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 63
    },
    "previous_report_ref": {
      "type": "string",
      "pattern": "^cesrr1:[0-9a-f]{64}$"
    },
    "previous_entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,95}$"
    },
    "correction_categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "source",
          "scope",
          "permission",
          "citation",
          "coverage"
        ]
      }
    },
    "repository_grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "title": "Independent per-repository append-correction opt-in",
        "additionalProperties": false,
        "properties": {
          "repository_ref": {
            "type": "string",
            "pattern": "^cesrepo1:[0-9a-f]{64}$"
          },
          "report_subject_ref": {
            "type": "string",
            "pattern": "^cesrs1:[0-9a-f]{64}$"
          },
          "permit_append_correction": {
            "const": true
          },
          "correction_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "repository_ref",
          "report_subject_ref",
          "permit_append_correction",
          "correction_receipt_sha256"
        ]
      }
    }
  },
  "required": [
    "schema",
    "purpose",
    "audience",
    "report_slot_ref",
    "slot_key",
    "period_id",
    "slot_members",
    "store_binding_sha256",
    "policy_receipt_sha256",
    "permit_append_correction",
    "expected_previous_version",
    "previous_report_ref",
    "previous_entry_sha256",
    "operation_id",
    "correction_categories",
    "repository_grants"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/references/report-history-correction-policy.v1.schema.json"
}
