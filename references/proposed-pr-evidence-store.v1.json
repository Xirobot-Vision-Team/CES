  },
  "operations": {
    "init": "Existing empty private root + --allow-init; creates manifest/lock/records once; does not authorize receipts",
    "preview": "Strict input projection/history scan, read-only approval scope calculation; no implicit permission",
    "commit": "--allow-evidence-write AND matching preview authorization digest; one no-overwrite append or explicit unavailable/unknown",
    "history": "Read-only tamper-checked per-subject revision state and TTL view"
  },
  "permissions": {
    "network": "NEVER_ACCESSED",
    "local_git": "NEVER_ACCESSED",
    "remote_write": "NEVER",
    "git_ref_index_or_worktree_write": "NEVER",
    "local_init": "EXPLICIT_ALLOW_INIT_DISTINCT_FROM_RECEIPT_WRITE",
    "local_append": "EXPLICIT_ALLOW_EVIDENCE_WRITE_AND_PREVIEW_SCOPE_DIGEST_PER_DISTINCT_APPEND",
    "approval_digest_authenticated_human_consent": false,
    "provider_or_local_positive_evidence_grants_append": false
  },
  "path_policy": {
    "store_root": "Preexisting empty exact absolute owner-private directory, no symlink ancestors",
    "store_id": "ASCII slug [a-z][a-z0-9_-]{2,47}",
    "manifest_root_and_instance_bound": true,
    "record_filename": "<keyed-HMAC-subject-hex>.<revision-6-digits>.json",
    "open": "POSIX dirfd O_NOFOLLOW O_DIRECTORY, private permissions; flock on fixed transaction lock",
    "write": "Exclusive private temp O_CREAT|O_EXCL, fsync, hard-link-to-fixed-name no-clobber, unlink own temp, directory fsync",
    "symlink_traversal_allowed": false,
    "arbitrary_parent_directory_creation": false,
    "old_receipt_rewrite": false,
    "orphan_auto_removal": false,
    "windows_unverified_fallback_writer": false
  },
  "receipt_schema": "ces.proposed_pr_evidence_receipt.v1",
  "store_manifest_schema": "ces.proposed_pr_evidence_store_manifest.v1",
  "disclosure_profile": "MINIMAL_SOURCE_LABELS_NO_PATHS_BODIES_OR_OIDS_V1",
  "disallowed_persisted_content": ["raw Provider JSON", "PR body/title", "access tokens and HTTP headers", "source file paths", "patch/diff content", "Git worktree path", "raw commit/tree/blob OIDs", "raw repository locator/request number"],
  "identity_integrity": {
    "subject": "Store-keyed HMAC of provider, repository locator, number, immutable proposal and target IDs",
    "pin": "Store-keyed HMAC of original unauthenticated EC162 pin fingerprint",
    "evidence": "Store-keyed HMAC of exact input JSON",
    "receipt_id": "SHA256 domain-separated canonical record body",
    "record_hmac": "Per-store HMAC of receipt body + ID; internal tamper detection only, key stored with manifest",
    "actor_authenticated": false,
    "provider_authenticated": false,
    "target_repo_membership_authenticated": false,
    "remote_merge_or_delivery_proven": false,
    "deployment_proven": false
  },
  "ttl": {
    "min_seconds": 60,
    "max_seconds": 3600,
    "default_seconds": 900,
    "input_observation_max_age_seconds": 900,
    "future_skew_max_seconds": 60,
    "no_provider_observation_unknown_ttl_max_seconds": 300,
    "expiry_basis": "Earliest available new source observation time, not later persistence time",
    "duplicate_same_input": "Read-only DUPLICATE_NO_WRITE while still active",
    "duplicate_expired": "UNAVAILABLE_REOBSERVE_WITH_NEW_SOURCE_NO_REAUTH_RENEWAL",
    "new_revision": "Requires fresh source evidence, newer provider-observed time where comparable, separate scoped write consent",
