{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/schemas/knowledge-target-delivery-statement.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.knowledge_target_delivery_statement.v1"
    },
    "purpose": {
      "const": "knowledge_delivered_target_commit"
    },
    "signer_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "repository_ref": {
      "type": "string",
      "pattern": "^cesrepo1:[0-9a-f]{64}$"
    },
    "knowledge_space_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "period_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "request_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_ref": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^refs/(heads|remotes)/[A-Za-z0-9._/-]+$"
    },
    "target_revision": {
      "type": "object",
      "properties": {
        "algorithm": {
          "enum": [
            "sha1",
            "sha256"
          ]
        },
        "oid": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        }
      },
      "required": [
        "algorithm",
        "oid"
      ],
      "additionalProperties": false
    },
    "delivered_at_utc": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
    },
    "knowledge_manifest_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "purpose",
    "signer_key_id",
    "repository_ref",
    "knowledge_space_key",
    "source_policy_revision",
    "period_id",
    "request_binding_sha256",
    "scope_binding_sha256",
    "target_ref",
    "target_revision",
    "delivered_at_utc",
    "knowledge_manifest_sha256"
  ]
}
