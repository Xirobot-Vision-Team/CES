{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/schema/issue-match-grant.v1.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/match_grant"
    },
    {
      "$ref": "#/$defs/title_grant"
    }
  ],
  "$defs": {
    "pin": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      ],
      "items": false
    },
    "match_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "provider",
        "api_host",
        "account_ref",
        "repository",
        "expected_repository_id",
        "candidate_pins",
        "request_sha256",
        "expires_at_utc",
        "authorized",
        "allow_write"
      ],
      "properties": {
        "method": {
          "const": "COMPARE_SELECTED_ISSUE_CANDIDATES"
        },
        "provider": {
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "api_host": {
          "enum": [
            "api.github.com",
            "gitlab.com"
          ]
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
        },
        "expected_repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "candidate_pins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expires_at_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
        },
        "authorized": {
          "const": true
        },
        "allow_write": {
          "const": false
        }
      }
    },
    "title_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "provider",
        "api_host",
        "account_ref",
        "repository",
        "expected_repository_id",
        "candidate_pins",
        "request_sha256",
        "expires_at_utc",
        "authorized",
        "allow_write",
        "allowed_privacies"
      ],
      "properties": {
        "method": {
          "const": "COMPARE_SELECTED_ISSUE_TITLES_IN_MEMORY"
        },
        "provider": {
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "api_host": {
          "enum": [
            "api.github.com",
            "gitlab.com"
          ]
        },
        "account_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
        },
        "expected_repository_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "candidate_pins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/pin"
          }
        },
        "request_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expires_at_utc": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
        },
        "authorized": {
          "const": true
        },
        "allow_write": {
          "const": false
        },
        "allowed_privacies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "STANDARD",
              "NOT_REPORTED",
              "CONFIDENTIAL"
            ]
          }
        }
      }
    }
  }
}
