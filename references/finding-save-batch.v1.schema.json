{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "store_id",
    "store_pin",
    "sequence",
    "previous_record_sha256",
    "finding_save_operation_id",
    "projection_operation_id",
    "input_operation_id",
    "validation_operation_id",
    "source_binding",
    "candidate_sha256",
    "validation_receipt_sha256",
    "projection_sha256",
    "projection_payload_sha256",
    "approved_payload_sha256",
    "authorization_audit",
    "source_observed_at_utc",
    "committed_at_utc",
    "expires_at_utc",
    "coverage",
    "historical_proposal_only",
    "saved_metadata_record_sha256",
    "findings",
    "verified_actual_ci_or_test",
    "defect_semantically_confirmed",
    "source_currentness_proven",
    "contains_raw_text",
    "business_repo_or_git_or_issue_modified",
    "record_sha256",
    "mac_sha256"
  ],
  "properties": {
    "store_pin": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "finding_save_operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projection_operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projection_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "approved_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mac_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema": {
      "const": "ces.finding_save_batch.v1"
    },
    "store_id": {
      "type": "string",
      "pattern": "^finding_v1_[0-9a-f]{32}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "previous_record_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "handoff_id",
        "stage_revision",
        "stage_event_sha256",
        "source_mode",
        "task_kind",
        "source_context_sha256",
        "source_identity_sha256",
        "evidence_hash",
        "material_sha256"
      ],
      "properties": {
        "stage_event_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_context_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_identity_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "evidence_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "material_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^run_v1_[0-9a-f]{48}$"
        },
        "handoff_id": {
          "type": "string",
          "pattern": "^handoff_v1_[0-9a-f]{48}$"
        },
        "stage_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_mode": {
          "enum": [
            "WorkingTree",
            "DeliveredTarget",
            "ProposedPR"
          ]
        },
        "task_kind": {
          "const": "code_analysis"
        }
      }
    },
    "authorization_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_operator_label_sha256",
        "approval_set_sha256",
        "approved_count",
        "source_mode",
        "per_finding_grants_checked",
        "operator_identity_authenticated",
        "explicit_historical_ack",
        "explicit_partial_coverage_ack",
        "explicit_non_reviewed_ack",
        "grant_basis"
      ],
      "properties": {
        "declared_operator_label_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_set_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "source_mode": {
          "enum": [
            "WorkingTree",
            "DeliveredTarget",
            "ProposedPR"
          ]
        },
        "per_finding_grants_checked": {
          "const": true
        },
        "operator_identity_authenticated": {
          "const": false
        },
        "explicit_historical_ack": {
          "type": "boolean"
        },
        "explicit_partial_coverage_ack": {
          "type": "boolean"
        },
        "explicit_non_reviewed_ack": {
          "type": "boolean"
        },
        "grant_basis": {
          "const": "EXPLICIT_CALLER_APPROVAL_NOT_AUTHENTICATED_ACTOR"
        }
      }
    },
    "source_observed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "committed_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "missing_count",
        "source_quality"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "missing_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1024
        },
        "source_quality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "historical_proposal_only": {
      "type": "boolean"
    },
    "saved_metadata_record_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "finding_id",
          "ordinal",
          "original_finding_sha256",
          "severity",
          "confidence_claim",
          "assessment_state",
          "assessment_basis",
          "attestation_sha256",
          "verifier_label_sha256",
          "title_sha256",
          "analysis_sha256",
          "suggested_action_sha256",
          "positive_anchor_sha256",
          "positive_quote_sha256",
          "counter_evidence",
          "uncertainty",
          "semantic_truth_proven",
          "actual_test_or_ci_proven",
          "current_live_git_proven",
          "operator_authenticated"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "original_finding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "title_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "analysis_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "suggested_action_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "schema": {
            "const": "ces.finding_save_entry.v1"
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          },
          "severity": {
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "confidence_claim": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "assessment_state": {
            "enum": [
              "UNVERIFIED",
              "REVIEWED",
              "REJECTED",
              "INCONCLUSIVE"
            ]
          },
          "assessment_basis": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "attestation_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "verifier_label_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "positive_anchor_sha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 32
          },
          "positive_quote_sha256": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "minItems": 1,
            "maxItems": 32
          },
          "counter_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "annotation_sha256",
                "interpretation_sha256",
                "anchor_sha256"
              ],
              "properties": {
                "annotation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "interpretation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "anchor_sha256": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "minItems": 1,
                  "maxItems": 3
                }
              }
            },
            "minItems": 0,
            "maxItems": 3
          },
          "uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 1,
            "maxItems": 16
          },
          "semantic_truth_proven": {
            "const": false
          },
          "actual_test_or_ci_proven": {
            "const": false
          },
          "current_live_git_proven": {
            "const": false
          },
          "operator_authenticated": {
            "const": false
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "assessment_state": {
                  "const": "UNVERIFIED"
                }
              }
            },
            "then": {
              "properties": {
                "attestation_sha256": {
                  "type": "null"
                },
                "verifier_label_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "attestation_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "verifier_label_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      },
      "minItems": 1,
      "maxItems": 32
    },
    "verified_actual_ci_or_test": {
      "const": false
    },
    "defect_semantically_confirmed": {
      "const": false
    },
    "source_currentness_proven": {
      "const": false
    },
    "contains_raw_text": {
      "const": false
    },
    "business_repo_or_git_or_issue_modified": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local.ces.invalid/ec178/finding-save-batch.v1.schema.json",
  "title": "CES EC178 immutable private FindingSave batch (local claims; NOT defect proof)",
  "description": "Normative stored record shape. Successful structure only; source integrity, MAC, identity, time/order and scoped permissions must additionally be reverified by finding_save.py. No text fields are permitted. Declarations are not test or semantic truth."
}
