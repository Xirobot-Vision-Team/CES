{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ces/issue-provider-result.v1.schema.json",
  "title": "CES EC211 bounded Issue provider metadata response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "reason_code", "exit_code", "read_state", "issue_existence", "source", "synthetic", "metadata_projection_only", "organizational_grant_authenticated", "native_issue_action_registered", "issue_sync_performed", "issue_created", "issue_delivered_or_published", "issue_or_provider_written", "business_repository_written"],
  "properties": {
    "schema": {"const": "ces.issue_provider.v1"},
    "status": {"enum": ["partial", "invalid_input", "unavailable"]},
    "reason_code": {"type": "string", "pattern": "^ISSUE_[A-Z0-9_]+$"},
    "exit_code": {"enum": [2, 4, 5]},
    "read_state": {"enum": ["UNKNOWN", "SYNTHETIC_OBSERVED", "PROVIDER_OBSERVED"]},
    "issue_existence": {"enum": ["UNKNOWN", "SYNTHETIC_FIXTURE_PRESENT", "PROVIDER_REPORTED_PRESENT"]},
    "source": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/source"}]},
    "synthetic": {"type": "boolean"},
    "metadata_projection_only": {"const": true},
    "organizational_grant_authenticated": {"const": false},
    "native_issue_action_registered": {"const": false},
    "issue_sync_performed": {"const": false},
    "issue_created": {"const": false},
    "issue_delivered_or_published": {"const": false},
    "issue_or_provider_written": {"const": false},
    "business_repository_written": {"const": false}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "partial"}}},
     "then": {"properties": {"exit_code": {"const": 2}, "source": {"$ref": "#/$defs/source"},
                           "reason_code": {"const": "ISSUE_METADATA_OBSERVED"}}}},
    {"if": {"properties": {"status": {"const": "unavailable"}}},
     "then": {"properties": {"exit_code": {"const": 5}, "source": {"type": "null"},
                           "read_state": {"const": "UNKNOWN"}, "issue_existence": {"const": "UNKNOWN"}}}},
    {"if": {"properties": {"status": {"const": "invalid_input"}}},
     "then": {"properties": {"exit_code": {"const": 4}, "source": {"type": "null"},
                           "read_state": {"const": "UNKNOWN"}, "issue_existence": {"const": "UNKNOWN"}}}},
    {"if": {"properties": {"source": {"$ref": "#/$defs/source"}, "synthetic": {"const": true}},
     "required": ["source", "synthetic"]},
     "then": {"properties": {"read_state": {"const": "SYNTHETIC_OBSERVED"},
                           "issue_existence": {"const": "SYNTHETIC_FIXTURE_PRESENT"}}}},
    {"if": {"properties": {"source": {"$ref": "#/$defs/source"}, "synthetic": {"const": false}},
     "required": ["source", "synthetic"]},
     "then": {"properties": {"read_state": {"const": "PROVIDER_OBSERVED"},
                           "issue_existence": {"const": "PROVIDER_REPORTED_PRESENT"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stamp": {"type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{6})Z$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "api_host", "repository_path", "provider_repository_id", "issue_number", "provider_issue_id"],
      "properties": {
        "provider": {"enum": ["github", "gitlab"]},
        "api_host": {"enum": ["api.github.com", "gitlab.com"]},
        "repository_path": {"type": "string", "minLength": 3, "maxLength": 240},
        "provider_repository_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "issue_number": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "provider_issue_id": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "identity_sha256", "snapshot_sha256", "snapshot_semantics", "provider_state", "provider_created_at_utc", "provider_updated_at_utc", "provider_closed_at_utc", "provider_confidentiality", "observed_at_utc", "origin", "provider_identity_claim", "snapshot_atomic", "all_issue_fields_collected", "title_body_labels_disclosed", "remote_creation_or_delivery_verified"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "identity_sha256": {"$ref": "#/$defs/hash"},
        "snapshot_sha256": {"$ref": "#/$defs/hash"},
        "snapshot_semantics": {"const": "SELECTED_PROVIDER_METADATA_AND_UNEXPOSED_TITLE_DESCRIPTION_LABELS_V1"},
        "provider_state": {"enum": ["OPEN", "CLOSED"]},
        "provider_created_at_utc": {"$ref": "#/$defs/stamp"},
        "provider_updated_at_utc": {"$ref": "#/$defs/stamp"},
        "provider_closed_at_utc": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stamp"}]},
        "provider_confidentiality": {"enum": ["CONFIDENTIAL", "STANDARD", "NOT_REPORTED"]},
        "observed_at_utc": {"$ref": "#/$defs/stamp"},
        "origin": {"enum": ["synthetic_fixture", "provider_https_response"]},
        "provider_identity_claim": {"const": "OBSERVED_ID_AND_REPOSITORY_LOCATOR_DOUBLE_CHECKED"},
        "snapshot_atomic": {"const": false},
        "all_issue_fields_collected": {"const": false},
        "title_body_labels_disclosed": {"const": false},
        "remote_creation_or_delivery_verified": {"const": false}
      }
    }
  },
  "description": "Only a bounded, non-atomic, redacted selected provider projection. Snapshot SHA covers undisclosed text and is sensitive equality information, not a cryptographic attestation or evidence of Issue creation, sync, or delivery."
}
