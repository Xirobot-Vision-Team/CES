{
  "type": "object",
  "title": "EC200 read-only report history policy",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.report_history_read_policy.v1"
    },
    "purpose": {
      "const": "periodic_report_internal_history_read_only"
    },
    "audience": {
      "const": "HUMAN_REPORT_EDITOR_INTERNAL"
    },
    "report_slot_ref": {
      "type": "string",
      "pattern": "^cesrslot1:[0-9a-f]{64}$"
    },
    "slot_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "period_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "slot_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository_ref": {
            "type": "string",
            "pattern": "^cesrepo1:[0-9a-f]{64}$"
          },
          "report_subject_ref": {
            "type": "string",
            "pattern": "^cesrs1:[0-9a-f]{64}$"
          }
        },
        "required": [
          "repository_ref",
          "report_subject_ref"
        ]
      }
    },
    "store_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permit_history_read": {
      "const": true
    },
    "permit_rendered_markdown": {
      "type": "boolean"
    },
    "repository_grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "title": "Independent declared per-repository read grant",
        "additionalProperties": false,
        "properties": {
          "repository_ref": {
            "type": "string",
            "pattern": "^cesrepo1:[0-9a-f]{64}$"
          },
          "report_subject_ref": {
            "type": "string",
            "pattern": "^cesrs1:[0-9a-f]{64}$"
          },
          "permit_history_read": {
            "const": true
          },
          "permit_rendered_markdown": {
            "type": "boolean"
          },
          "read_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "repository_ref",
          "report_subject_ref",
          "permit_history_read",
          "permit_rendered_markdown",
          "read_receipt_sha256"
        ]
      }
    }
  },
  "required": [
    "schema",
    "purpose",
    "audience",
    "report_slot_ref",
    "slot_key",
    "period_id",
    "slot_members",
    "store_binding_sha256",
    "policy_receipt_sha256",
    "permit_history_read",
    "permit_rendered_markdown",
    "repository_grants"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/references/report-history-read-policy.v1.schema.json"
}
