{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.knowledge_update_handoff_request.v1"
    },
    "task_kind": {
      "const": "knowledge_update"
    },
    "handoff_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "repository_ref": {
      "type": "string",
      "pattern": "^cesrepo1:[0-9a-f]{64}$"
    },
    "knowledge_space_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "period_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "candidate_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{2,63}$"
      }
    }
  },
  "required": [
    "schema",
    "task_kind",
    "handoff_key",
    "repository_ref",
    "knowledge_space_key",
    "period_id",
    "source_policy_revision",
    "candidate_keys"
  ]
}
