{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ces.local/knowledge-lifecycle-query-request.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "view",
    "selected_version_id",
    "expected_head_version_id",
    "expected_chapter_sha256",
    "section_indices",
    "projection",
    "search_terms"
  ],
  "properties": {
    "schema": {
      "const": "ces.knowledge_lifecycle_query_request.v1"
    },
    "operation": {
      "const": "knowledge.lifecycle.query"
    },
    "view": {
      "enum": [
        "source_snapshot",
        "local_metadata_version"
      ]
    },
    "selected_version_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_head_version_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_chapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "section_indices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 63
      }
    },
    "projection": {
      "enum": [
        "hashes_only",
        "match_snippets",
        "full_sections"
      ]
    },
    "search_terms": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 72,
        "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "view": {
            "const": "source_snapshot"
          }
        }
      },
      "then": {
        "properties": {
          "selected_version_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "selected_version_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "projection": {
            "const": "match_snippets"
          }
        }
      },
      "then": {
        "properties": {
          "search_terms": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "search_terms": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
