{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ces.local/knowledge-save-request.v1.schema.json",
  "title": "knowledge-save-request",
  "description": "EC208 one-section byte-exact human reviewed draft pinned to EC207 and current metadata parent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "save_key",
    "repository_ref",
    "knowledge_space_key",
    "period_id",
    "source_policy_revision",
    "chapter_path",
    "expected_snapshot_version",
    "expected_manifest_sha256",
    "expected_baseline_chapter_sha256",
    "expected_parent_version_id",
    "expected_parent_content_sha256",
    "section_index",
    "expected_section_sha256",
    "section_ref",
    "ec202_knowledge_source_binding_sha256",
    "save_permission_receipt_sha256",
    "replacement_section_base64",
    "replacement_section_sha256",
    "expected_new_chapter_sha256",
    "selection_binding_sha256",
    "ai_input_sha256",
    "candidate_keys",
    "candidate_record_ids",
    "review_summary"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "ces.knowledge_save_request.v1"
    },
    "operation": {
      "type": "string",
      "const": "knowledge.save.metadata_version"
    },
    "save_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "repository_ref": {
      "type": "string",
      "pattern": "^cesrepo1:[0-9a-f]{64}$"
    },
    "knowledge_space_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "period_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "source_policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "chapter_path": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9_][A-Za-z0-9._/-]*\\.(?:md|markdown)$"
    },
    "expected_snapshot_version": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "expected_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_baseline_chapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_parent_version_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_parent_content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "section_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 63
    },
    "expected_section_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "section_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^cesksection1:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ec202_knowledge_source_binding_sha256": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "save_permission_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "replacement_section_base64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]+={0,2}$",
      "minLength": 4,
      "maxLength": 21848
    },
    "replacement_section_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expected_new_chapter_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ai_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{2,63}$"
      }
    },
    "candidate_record_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "review_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "section_ref": {
            "type": "null"
          }
        },
        "required": [
          "section_ref"
        ]
      },
      "then": {
        "properties": {
          "ec202_knowledge_source_binding_sha256": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "ec202_knowledge_source_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
