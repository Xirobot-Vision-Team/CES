    "ec165_schema": "ces.proposed_pr_snapshot.v1",
    "request_locator": ["provider", "repository", "number"],
    "prior_pin_max_bytes": 65536,
    "prior_snapshot_max_bytes": 4194304,
    "duplicate_json_keys_rejected": true,
    "network_by_default": "DENIED",
    "network_opt_in": "--allow-network",
    "credential_env": {"github": "CES_GITHUB_TOKEN", "gitlab": "CES_GITLAB_TOKEN"},
