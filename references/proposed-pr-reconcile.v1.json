    "native_cli_action_registered", "diff_snapshot_proven", "provider_actor_verified",
    "delivery_or_merge_proven", "write_authorized"
  ],
  "states": {
    "FRESH_OBSERVATION": "New metadata matches prior full pin, plus an exact advertised file count when prior EC165 exists; old pages/patches do NOT become current",
    "STALE_BY_DRIFT": "At least one mandatory prior identity/OID/state/merge/count/quality claim differs; prior EC165 controlled output invalidated for current use",
    "UNAVAILABLE_UNKNOWN": "No complete comparable observation: denied read, missing fork or diff_refs, unsupported state, count unavailable/capped, incompatible origin or invalid input"
  },
  "status_exit_code": {"partial": 2, "invalid_input": 4, "unavailable": 5},
  "success_status_supported": false,
  "comparison_fields": [
    "pin_state", "count_state", "changed_fields", "changes",
    "prior_evidence_invalidated_by_metadata"
  ],
  "count_states": ["NOT_CHECKED", "NOT_BASELINED", "CHANGED", "INDETERMINATE", "MATCHED_EXACT_CLAIM"],
  "prior_observation_authentication": "NOT_PROVEN",
  "old_snapshot_currentness": "NEVER_PROVEN_BY_METADATA_RECHECK",
  "always_false": [
