    ],
    "ec165_extra_comparisons": ["provider_reported_changed_files", "provider_change_count_quality"],
    "gitlab_target_tip_meaning": "diff_refs.start_sha at provider's diff-version observation, not necessarily latest current target branch tip"
  },
  "output_keys": [
    "schema", "status", "exit_code", "reconciliation_state", "reason_code", "message",
