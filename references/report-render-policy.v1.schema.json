{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/references/report-render-policy.v1.schema.json",
  "title": "CES EC199 independent internal render and private save grants",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.report_render_policy.v1"
    },
    "purpose": {
      "const": "periodic_report_internal_render_only"
    },
    "audience": {
      "const": "HUMAN_REPORT_EDITOR_INTERNAL"
    },
    "permit_internal_render": {
      "const": true
    },
    "permit_local_save": {
      "type": "boolean"
    },
    "slot_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "draft_ref": {
      "type": "string",
      "pattern": "^cesrhd1:[0-9a-f]{64}$"
    },
    "draft_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review_policy_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prepare_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ai_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scope_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metrics_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "period_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "policy_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repository_grants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "repository_ref": {
            "type": "string",
            "pattern": "^cesrepo1:[0-9a-f]{64}$"
          },
          "report_subject_ref": {
            "type": "string",
            "pattern": "^cesrs1:[0-9a-f]{64}$"
          },
          "source_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "people_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "permit_internal_render": {
            "const": true
          },
          "permit_local_save": {
            "type": "boolean"
          },
          "render_receipt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "approved_citation_refs": {
            "type": "array",
            "maxItems": 512,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^cesrc1:[0-9a-f]{64}$"
            }
          }
        },
        "required": [
          "repository_ref",
          "report_subject_ref",
          "source_binding_sha256",
          "people_binding_sha256",
          "permit_internal_render",
          "permit_local_save",
          "render_receipt_sha256",
          "approved_citation_refs"
        ]
      }
    }
  },
  "required": [
    "schema",
    "purpose",
    "audience",
    "permit_internal_render",
    "permit_local_save",
    "slot_key",
    "draft_ref",
    "draft_binding_sha256",
    "review_policy_binding_sha256",
    "prepare_binding_sha256",
    "ai_input_sha256",
    "scope_binding_sha256",
    "metrics_binding_sha256",
    "period_id",
    "policy_receipt_sha256",
    "repository_grants"
  ]
}
