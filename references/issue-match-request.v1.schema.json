{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "expected_repository_id",
    "candidates",
    "subject_anchors",
    "subject_title",
    "title_policy",
    "title_privacies",
    "max_observation_age_seconds"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
    },
    "expected_repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "expected_provider_issue_id",
          "anchors"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "expected_provider_issue_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "anchors": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/anchor"
            }
          }
        }
      }
    },
    "subject_anchors": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "subject_title": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "title_policy": {
      "enum": [
        "DISABLED",
        "AUTHORIZED"
      ]
    },
    "title_privacies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "STANDARD",
          "NOT_REPORTED",
          "CONFIDENTIAL"
        ]
      }
    },
    "max_observation_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/schema/issue-match-request.v1.schema.json",
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit_sha",
        "path",
        "line_start",
        "line_end",
        "evidence_sha256"
      ],
      "properties": {
        "commit_sha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*//)[^\\\\\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "line_end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "evidence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "title_policy": {
            "const": "DISABLED"
          }
        },
        "required": [
          "title_policy"
        ]
      },
      "then": {
        "properties": {
          "subject_title": {
            "type": "null"
          },
          "title_privacies": {
            "const": [
              "STANDARD"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "title_policy": {
            "const": "AUTHORIZED"
          }
        },
        "required": [
          "title_policy"
        ]
      },
      "then": {
        "properties": {
          "subject_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  ]
}
