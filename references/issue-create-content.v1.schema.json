{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/ces/issue-create-content.v1.schema.json",
  "title": "EC217 exact finalized Issue content after separate human sanitization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "body",
    "labels",
    "citations"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 100
    },
    "body": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000
    },
    "labels": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9 _.-]{0,39}$"
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reference_id",
          "anchor_binding_sha256"
        ],
        "properties": {
          "reference_id": {
            "type": "string",
            "pattern": "^E(0[1-9]|1[0-6])$"
          },
          "anchor_binding_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
