        "SYNTHETIC_FIXTURE_PRESENT",
        "PROVIDER_REPORTED_PRESENT"
      ]
    },
    "filter_outcome": {
      "enum": [
        "UNKNOWN",
        "MATCHED",
        "EXCLUDED_BY_FILTER"
      ]
    },
    "coverage": {
      "enum": [
        "UNKNOWN",
        "EXACT_ISSUE_SELECTED_METADATA_NONATOMIC"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "scope": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/scope"
        }
      ]
    },
    "issue": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/issue"
        }
      ]
    },
    "source_origin": {
      "enum": [
        null,
