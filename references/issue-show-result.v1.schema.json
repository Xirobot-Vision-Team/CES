  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ces/issue-show-result.v1.schema.json",
  "title": "CES EC213 single IssueShow redacted read-only response",
  "description": "Observed/filtered means only a bounded non-atomic projection of the exact selected provider Issue, not an atomic snapshot or full contents. No absence proof on 404, no authenticated organizational grant or source snapshot from caller.",
  "$defs": {
    "stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confidentiality",
        "updated_not_before_utc",
        "updated_before_utc"
      ],
      "properties": {
        "state": {
          "enum": [
            "ANY",
            "OPEN",
            "CLOSED"
          ]
        },
        "confidentiality": {
          "enum": [
            "ANY",
            "NOT_REPORTED",
            "STANDARD",
            "CONFIDENTIAL"
          ]
        },
        "updated_not_before_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stamp"
            }
          ]
        },
        "updated_before_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stamp"
            }
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "api_host",
        "repository_path",
        "provider_repository_id",
        "issue_number",
        "provider_issue_id"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "api_host": {
          "enum": [
            "api.github.com",
            "gitlab.com"
          ]
        },
        "repository_path": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
        },
        "provider_repository_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "issue_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "provider_issue_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "identity_sha256",
        "snapshot_sha256",
        "provider_state",
        "provider_created_at_utc",
        "provider_updated_at_utc",
        "provider_closed_at_utc",
        "provider_confidentiality",
        "observed_at_utc",
        "observation_origin",
        "snapshot_semantics",
        "source_limited_to_selected_metadata"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "identity_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provider_state": {
          "enum": [
            "OPEN",
            "CLOSED"
          ]
        },
        "provider_created_at_utc": {
          "$ref": "#/$defs/stamp"
        },
        "provider_updated_at_utc": {
          "$ref": "#/$defs/stamp"
        },
        "provider_closed_at_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stamp"
            }
          ]
        },
        "provider_confidentiality": {
          "enum": [
            "NOT_REPORTED",
            "STANDARD",
            "CONFIDENTIAL"
          ]
        },
        "observed_at_utc": {
          "$ref": "#/$defs/stamp"
        },
        "observation_origin": {
          "enum": [
            "synthetic_fixture",
            "provider_https_response"
          ]
        },
        "snapshot_semantics": {
          "const": "SELECTED_PROVIDER_METADATA_AND_UNEXPOSED_TITLE_DESCRIPTION_LABELS_V1"
        },
        "source_limited_to_selected_metadata": {
          "const": true
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "api_host",
        "repository",
        "expected_repository_id",
        "number",
        "expected_provider_issue_id",
        "filters",
        "max_observation_age_seconds"
      ],
      "properties": {
        "provider": {
          "enum": [
            "github",
            "gitlab"
          ]
        },
        "api_host": {
          "enum": [
            "api.github.com",
            "gitlab.com"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240,
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
        },
        "expected_repository_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "expected_provider_issue_id": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "filters": {
          "$ref": "#/$defs/filters"
        },
        "max_observation_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
