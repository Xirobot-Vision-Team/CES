        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/stamp"
        }
      ]
    },
    "freshness_seconds": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        }
      ]
    },
    "provider_read_invocations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "maximum_possible_provider_gets": {
      "enum": [
        0,
        3
      ]
    },
    "metadata_projection_only": {
      "const": true
    },
    "full_issue_contents": {
      "const": false
    },
    "snapshot_atomic": {
      "const": false
    },
    "full_repository_inventory": {
      "const": false
    },
    "caller_snapshot_trusted": {
      "const": false
    },
