{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.knowledge_chapters.v1"
    },
    "status": {
      "enum": [
        "partial",
        "invalid_input",
        "unavailable"
      ]
    },
    "exit_code": {
      "enum": [
        2,
        4,
        5
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^KNOWLEDGE_CHAPTERS_[A-Z0-9_]+$"
    },
    "subject": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scope_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "repository_root_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "knowledge_root_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "git_root_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target_config_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "issuer_registry_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "baseline_issuer_registry_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_bindings": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                  },
                  "source_binding_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "source_key",
                  "source_binding_sha256"
                ]
              }
            },
            "bootstrap_read_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target_read_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "impact_read_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target_statement_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "baseline_statement_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "request_binding_sha256",
            "scope_binding_sha256",
            "repository_root_binding_sha256",
            "knowledge_root_binding_sha256",
            "git_root_binding_sha256",
            "target_config_binding_sha256",
            "issuer_registry_binding_sha256",
            "baseline_issuer_registry_binding_sha256",
            "source_bindings",
            "bootstrap_read_policy_binding_sha256",
            "target_read_policy_binding_sha256",
            "impact_read_policy_binding_sha256",
            "target_statement_binding_sha256",
            "baseline_statement_binding_sha256"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model_revision": {
              "const": "EC205_EXPLICIT_EXISTING_CHAPTER_LINKS_ONLY"
            },
            "repository_ref": {
              "type": "string",
              "pattern": "^cesrepo1:[0-9a-f]{64}$"
            },
            "knowledge_space_key": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
            },
            "period_id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
            },
            "request_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scope_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bootstrap_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "impact_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "chapter_policy_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "baseline_statement_binding_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "target_delivery_state": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "selected_change_set_state": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "target_ref_post_chapter_read_state": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            },
            "knowledge_snapshot_stable_across_read": {
              "type": "boolean"
            },
            "knowledge_manifest": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+$"
                },
                "manifest_sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "snapshot_version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "captured_at_utc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\dZ$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "declared_coverage": {
                  "enum": [
                    "complete_declared",
                    "partial_declared",
                    "unknown"
                  ]
                },
                "period_relation": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+$"
                },
                "declared_entries": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unselected_entries": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 32
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "state",
                "manifest_sha256",
                "snapshot_version",
                "captured_at_utc",
                "declared_coverage",
                "period_relation",
                "declared_entries",
                "unselected_entries"
              ]
            },
            "snapshot_recency_signal": {
              "enum": [
                "UNKNOWN_UNVERIFIED_SNAPSHOT_OR_TARGET_TIME",
                "DECLARED_SNAPSHOT_PREDATES_SIGNED_TARGET_UNVERIFIED_TIME",
                "DECLARED_SNAPSHOT_NOT_EARLIER_UNVERIFIED_TIME"
              ]
            },
            "chapter_documents": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                  },
                  "relative_path": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "local_snapshot_state": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$"
                  },
                  "mapping_state": {
                    "enum": [
                      "DENIED_NOT_MAPPED",
                      "UNKNOWN_SNAPSHOT_CHANGED_DURING_ANALYSIS",
                      "UNKNOWN_MANIFEST_OR_KNOWLEDGE_BYTES",
                      "UNKNOWN_UNSUPPORTED_CHAPTER_FORMAT",
                      "UNKNOWN_UNPARSABLE_OR_UNBOUNDED_MARKDOWN",
                      "SELECTED_SNAPSHOT_CHAPTERS_SCANNED"
                    ]
                  },
                  "section_count": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unrelated_sections_not_projected": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 64
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "unresolved_explicit_references": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sections": {
                    "type": "array",
                    "maxItems": 64,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "section_ref": {
                          "type": "string",
                          "pattern": "^cesksection1:[0-9a-f]{64}$"
                        },
                        "ordinal": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 63
                        },
                        "heading_level": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        },
                        "heading": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 160
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "section_sha256": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[0-9a-f]{64}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "associations": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 32,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "source_key": {
                                "type": "string",
                                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
                              },
                              "association_methods": {
                                "type": "array",
                                "minItems": 1,
                                "maxItems": 2,
                                "uniqueItems": true,
                                "items": {
                                  "enum": [
                                    "EXPLICIT_CES_SOURCE_ANNOTATION",
                                    "EXACT_MARKDOWN_LINK"
                                  ]
                                }
                              },
                              "staleness_signal": {
                                "enum": [
                                  "UNKNOWN_STALENESS_NOT_ESTABLISHED",
                                  "CONFLICTING_DOCUMENTED_SOURCE_FINGERPRINTS",
                                  "DOCUMENTED_FINGERPRINT_MISMATCH_CANDIDATE",
                                  "DOCUMENTED_FINGERPRINT_MATCH_NOT_SEMANTIC_PROOF",
                                  "POTENTIALLY_STALE_SELECTED_GIT_CONTENT_CHANGED",
                                  "MODE_ONLY_NO_CONTENT_STALENESS_PROOF",
                                  "NO_SELECTED_CHANGE_NOT_KNOWLEDGE_FRESHNESS_PROOF"
                                ]
                              },
                              "selected_git_change_kind": {
                                "enum": [
                                  "ADDED",
                                  "MODIFIED",
                                  "MODE_ONLY",
                                  "UNCHANGED",
                                  "UNKNOWN"
                                ]
                              },
                              "selected_git_comparison_state": {
                                "type": "string",
                                "pattern": "^[A-Z0-9_]+$"
                              },
                              "documented_fingerprint_state": {
                                "enum": [
                                  "CONFLICTING_DOCUMENTED_FINGERPRINTS",
                                  "LINK_ONLY_NO_DOCUMENTED_FINGERPRINT",
                                  "FINGERPRINT_COMPARISON_NOT_AUTHORIZED",
                                  "TARGET_DIGEST_NOT_VERIFIED_OR_NOT_PROJECTED",
                                  "DOCUMENTED_FINGERPRINT_MATCHES_TARGET",
                                  "DOCUMENTED_FINGERPRINT_DIFFERS_FROM_TARGET"
                                ]
                              },
                              "review_state": {
                                "enum": [
                                  "UNKNOWN_SELECTED_SOURCE_EVIDENCE",
                                  "REVIEW_CONFLICTING_DOCUMENTED_FINGERPRINTS",
                                  "REVIEW_DOCUMENTED_FINGERPRINT_DIFFERS",
                                  "NO_FINGERPRINT_MISMATCH_SEMANTICS_UNKNOWN",
                                  "REVIEW_CHANGED_SELECTED_SOURCE",
                                  "REVIEW_MODE_ONLY_NOT_CONTENT_STALENESS",
                                  "NO_SELECTED_CHANGE_SIGNAL_NOT_FRESHNESS_PROOF"
                                ]
                              },
                              "manual_review_candidate": {
                                "type": "boolean"
                              },
                              "semantic_dependency_or_staleness_verified": {
                                "const": false
                              }
                            },
                            "required": [
                              "source_key",
                              "association_methods",
                              "staleness_signal",
                              "selected_git_change_kind",
                              "selected_git_comparison_state",
                              "documented_fingerprint_state",
                              "review_state",
                              "manual_review_candidate",
                              "semantic_dependency_or_staleness_verified"
                            ]
                          }
                        },
                        "manual_review_candidate": {
                          "type": "boolean"
                        },
                        "semantic_diff_verified": {
                          "const": false
                        }
                      },
                      "required": [
                        "section_ref",
                        "ordinal",
                        "heading_level",
                        "heading",
                        "section_sha256",
                        "associations",
                        "manual_review_candidate",
                        "semantic_diff_verified"
                      ]
                    }
                  }
                },
                "required": [
                  "source_key",
                  "relative_path",
                  "local_snapshot_state",
                  "mapping_state",
                  "section_count",
                  "unrelated_sections_not_projected",
                  "unresolved_explicit_references",
                  "sections"
                ]
              }
            },
            "summary": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "selected_knowledge_documents": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "knowledge_documents_mapped": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "knowledge_documents_unknown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "visible_selected_sections": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "sections_with_explicit_selected_source_links": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "manual_review_candidate_sections": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "unrelated_sections_not_projected": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "unresolved_explicit_refs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2048
                },
                "changed_selected_sources_without_visible_link": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                },
                "whole_knowledge_space_linkage_complete": {
                  "const": false
                },
                "semantic_chapter_differences_verified": {
                  "const": false
                },
                "knowledge_update_authorized": {
                  "const": false
                }
              },
              "required": [
                "selected_knowledge_documents",
                "knowledge_documents_mapped",
                "knowledge_documents_unknown",
                "visible_selected_sections",
                "sections_with_explicit_selected_source_links",
                "manual_review_candidate_sections",
                "unrelated_sections_not_projected",
                "unresolved_explicit_refs",
                "changed_selected_sources_without_visible_link",
                "whole_knowledge_space_linkage_complete",
                "semantic_chapter_differences_verified",
                "knowledge_update_authorized"
              ]
            },
            "unmapped_changed_selected_source_keys": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
              }
            },
            "uncertainty_reasons": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              }
            },
            "knowledge_sections_to_update": {
              "type": "array",
              "maxItems": 0
            },
            "verified_delivered_facts": {
              "type": "array",
              "maxItems": 0
            },
            "no_write_actions_performed": {
              "const": true
            },
            "next_unimplemented": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
              }
            }
          },
          "required": [
            "model_revision",
            "repository_ref",
            "knowledge_space_key",
            "period_id",
            "request_binding_sha256",
            "scope_binding_sha256",
            "bootstrap_policy_binding_sha256",
            "target_policy_binding_sha256",
            "impact_policy_binding_sha256",
            "chapter_policy_binding_sha256",
            "baseline_statement_binding_sha256",
            "target_delivery_state",
            "selected_change_set_state",
            "target_ref_post_chapter_read_state",
            "knowledge_snapshot_stable_across_read",
            "knowledge_manifest",
            "snapshot_recency_signal",
            "chapter_documents",
            "summary",
            "unmapped_changed_selected_source_keys",
            "uncertainty_reasons",
            "knowledge_sections_to_update",
            "verified_delivered_facts",
            "no_write_actions_performed",
            "next_unimplemented"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_json": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500000
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "automatic_sections_to_rewrite_identified": {
          "const": false
        },
        "business_source_repository_issue_or_knowledge_write_performed": {
          "const": false
        },
        "candidate_store_save_publication_or_ai_dispatch_performed": {
          "const": false
        },
        "chapter_semantic_staleness_or_conflict_proven": {
          "const": false
        },
        "historical_knowledge_versions_or_text_diffs_verified": {
          "const": false
        },
        "markdown_links_prove_architectural_dependency": {
          "const": false
        },
        "native_powershell_knowledge_route_registered": {
          "const": false
        },
        "organizational_identity_grants_or_signer_revocation_verified": {
          "const": false
        },
        "repository_delivery_or_deployment_authoritatively_verified": {
          "const": false
        },
        "snapshot_claims_semantically_authenticated": {
          "const": false
        },
        "unselected_knowledge_documents_or_source_paths_scanned": {
          "const": false
        }
      },
      "required": [
        "automatic_sections_to_rewrite_identified",
        "business_source_repository_issue_or_knowledge_write_performed",
        "candidate_store_save_publication_or_ai_dispatch_performed",
        "chapter_semantic_staleness_or_conflict_proven",
        "historical_knowledge_versions_or_text_diffs_verified",
        "markdown_links_prove_architectural_dependency",
        "native_powershell_knowledge_route_registered",
        "organizational_identity_grants_or_signer_revocation_verified",
        "repository_delivery_or_deployment_authoritatively_verified",
        "snapshot_claims_semantically_authenticated",
        "unselected_knowledge_documents_or_source_paths_scanned"
      ]
    }
  },
  "required": [
    "schema",
    "status",
    "exit_code",
    "reason_code",
    "subject",
    "canonical_json",
    "limitations"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          },
          "subject": {
            "type": "object"
          },
          "canonical_json": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_input"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 4
          },
          "subject": {
            "type": "null"
          },
          "canonical_json": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 5
          },
          "subject": {
            "type": "null"
          },
          "canonical_json": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ces.local/schemas/knowledge-chapters-result.v1.schema.json",
  "title": "EC205 read-only chapter-to-source mapping observation"
}
