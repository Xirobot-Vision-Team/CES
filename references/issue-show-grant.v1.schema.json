{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "method",
    "provider",
    "api_host",
    "account_ref",
    "repository",
    "expected_repository_id",
    "number",
    "expected_provider_issue_id",
    "filters",
    "max_observation_age_seconds",
    "expires_at_utc",
    "authorized",
    "allow_write"
  ],
  "properties": {
    "method": {
      "const": "READ_ISSUE_SHOW"
    },
    "provider": {
      "enum": [
        "github",
        "gitlab"
      ]
    },
    "api_host": {
      "enum": [
        "api.github.com",
        "gitlab.com"
      ]
    },
    "account_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}(?:/[A-Za-z0-9_][A-Za-z0-9_.-]{0,99}){1,11}$"
    },
    "expected_repository_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "number": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "expected_provider_issue_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "filters": {
      "$ref": "#/$defs/filters"
    },
    "max_observation_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "expires_at_utc": {
      "$ref": "#/$defs/stamp"
    },
    "authorized": {
      "const": true
    },
    "allow_write": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ces/issue-show-grant.v1.schema.json",
  "title": "CES EC213 independent host-declared single exact IssueShow grant",
  "description": "Not a cryptographic grant. EC211 exact read permission and explicit opt-in/credentials are additionally required. Python enforces grant expiry <=300 seconds, exact scope and filter match, repository provider syntax and no write.",
  "$defs": {
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "confidentiality",
        "updated_not_before_utc",
        "updated_before_utc"
      ],
      "properties": {
        "state": {
          "enum": [
            "ANY",
            "OPEN",
            "CLOSED"
          ]
        },
        "confidentiality": {
          "enum": [
            "ANY",
            "NOT_REPORTED",
            "STANDARD",
            "CONFIDENTIAL"
          ]
        },
        "updated_not_before_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stamp"
            }
          ]
        },
        "updated_before_utc": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stamp"
            }
          ]
        }
      }
    },
    "stamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{1,6})?Z$"
    }
  }
}
