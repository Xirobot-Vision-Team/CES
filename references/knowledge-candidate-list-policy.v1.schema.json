{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ces.knowledge_candidate_list_policy.v1"
    },
    "purpose": {
      "const": "list_private_candidate_keys_only"
    },
    "store_instance_id": {
      "type": "string",
      "format": "uuid"
    },
    "store_scope_binding_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authorization_scope_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permission_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "permit_candidate_keys_list": {
      "type": "boolean"
    },
    "permit_repository_write": {
      "const": false
    },
    "permit_authoritative_knowledge_write": {
      "const": false
    },
    "permit_publish": {
      "const": false
    }
  },
  "required": [
    "schema",
    "purpose",
    "store_instance_id",
    "store_scope_binding_sha256",
    "authorization_scope_sha256",
    "permission_receipt_sha256",
    "permit_candidate_keys_list",
    "permit_repository_write",
    "permit_authoritative_knowledge_write",
    "permit_publish"
  ]
}
